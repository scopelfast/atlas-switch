# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
# URL pública usada em links de convite (/invite?token=… e recuperação de senha). Deve coincidir com o host onde a app corre. Sem barra no fim.
BASE_URL=http://localhost:3003
# Opcional: validade do link de convite em dias (M2.1). Predefinido: 7. Máximo: 365.
# INVITE_LINK_TTL_DAYS=7
# Opcional: após confirmar o e-mail (estado activated), prazo em dias para definir senha (M2.4). Predefinido: 30. Máximo: 365.
# INVITE_ACTIVATED_TO_PASSWORD_DAYS=30
AUTH_SECRET=***
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM="AtlasSwitch <no-reply@exemplo.com>"

# --- I8.4 — Integrações globais (opcional; activar toggles em /dashboard/control-integrations) ---
# Google Calendar / OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=${BASE_URL}/api/chronos/google-calendar/oauth-callback
# Microsoft Graph (E8.12 — OAuth; registe o mesmo redirect na app Azure AD)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=${BASE_URL}/api/chronos/microsoft-graph/oauth-callback
# WhatsApp Business API (nunca gravar na BD)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# --- E8.11 — Modelo na nuvem (opt-in por equipa + toggles em /dashboard/control-integrations) ---
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# --- E8.19 — TTS / notificações faladas (MVP: Web Speech API no browser; Coqui = evolução self-hosted) ---
# Sem variável obrigatória. Futuro: COQUI_TTS_INTERNAL_URL=http://tts-worker:5000
# --- E8.18 — Reunify ASR (AssemblyAI; opt-in por equipa em reunifyAsrProvider) ---
# Áudio de uploads é enviado aos servidores AssemblyAI quando o gestor activa o fornecedor e existe chave.
# ASSEMBLYAI_API_KEY=
# --- IM3.2 — Reconciliação agendada Reunify -> Chronos ---
# Segredo do endpoint agendado POST /api/chronos/agenda/reconcile-reunify/scheduled
# Pode usar CRON_SECRET (preferido) ou ATLAS_CRON_SECRET.
# CRON_SECRET=
# ATLAS_CRON_SECRET=